{
  "manifest_version": 3,
  "name": "InkbornForge",
  "version": "1.4.0",
  "description": "Capture live duels.ink games for InkbornForge, and pull inkDecks pages to JSON in one click.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://duels.ink/*",
    "https://inkdecks.com/*",
    "https://www.inkbornforge.com/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://duels.ink/spectate/*"],
      "js": ["patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://duels.ink/spectate/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.inkbornforge.com/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InkbornForge"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
