{
  "manifest_version": 3,
  "name": "Lorcana Game Scraper",
  "version": "1.1.0",
  "description": "Automatically capture live Lorcana Duels gameplay for analysis",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://duels.ink/*",
    "https://lorcana-pro-tools.vercel.app/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://duels.ink/spectate/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lorcana-pro-tools.vercel.app/*",
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lorcana Game Scraper"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
