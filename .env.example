# Supabase environment variables for local development
# Copy this file to .env and fill in your actual values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Vercel's Supabase integration automatically creates NEXT_PUBLIC_* versions
# which also work in Vite for frontend access
